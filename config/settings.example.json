{
  "general": {
    "launch_on_startup": false,
    "start_minimized": false,
    "start_hidden_no_terminal": true,
    "show_floating_bar_on_startup": true,
    "sound_effects": false,
    "always_on_top": true,
    "theme": "black_white_minimal",
    "paused": false
  },
  "floating_bar": {
    "x": null,
    "y": null,
    "position": {
      "x": null,
      "y": null
    },
    "remember_position": true,
    "alt_drag_only": true,
    "visible": true,
    "hidden": false
  },
  "hotkeys": {
    "push_to_talk": "<ctrl>+<win>",
    "push_to_talk_backup": "<f8>",
    "toggle_recording": "<f9>",
