    "language_mode": "english",
    "speed_mode": "balanced",
    "engine_mode": "safe_cpu",
    "safe_mode_implementation": "isolated_subprocess",
    "device_preference": "cpu",
    "compute_type_gpu": "float16",
    "compute_type_cpu": "int8"
  },
