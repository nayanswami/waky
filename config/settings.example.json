    "alternatives": [
      "<ctrl>+<cmd>",
      "<ctrl>+<shift>+<space>"
    ]
  },
  "audio": {
    "microphone": null,
    "sample_rate": 16000,
    "channels": 1,
    "silence_trimming": true,
    "min_record_seconds": 0.25
